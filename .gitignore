# Data / artefacts — local only, not tracked
#
# `artifacts/*`, not `artifacts/`. Git cannot re-include a file whose parent
# directory is excluded, so a directory-level ignore makes every negation below
# silently inert — which is what happened: the tracked manifests and evaluation
# JSONs all had to be force-added, and a new result file would have been
# quietly left untracked. Each level is re-included and then re-excluded so the
# exceptions at the bottom actually take effect.
artifacts/*
!artifacts/zuna_thesis/
artifacts/zuna_thesis/*
!artifacts/zuna_thesis/baseline_eval/
artifacts/zuna_thesis/baseline_eval/*
!artifacts/zuna_thesis/compare_first10/
artifacts/zuna_thesis/compare_first10/*
sample_data/
*.probs.npz
*.reviewed.csv_bi
*.h5
*.zip

# ...but the pretrained detector weights ARE the runtime dependency: gui/io/infer.py,
# run_inference.py, precompute_probs.py and eval_config.py all resolve this exact
# filename, so a clone without it cannot score anything. 4.46 MiB, well within limits.
# Shipped unmodified (optimizer state and all) so its sha256 still matches the hash
# recorded in eval_config.WEIGHTS_SHA256 and stamped into every export's provenance.
!convlstm_ICA_12_train.h5

# The evaluation manifest is a small text index, not data — it names which public
# TUSZ files a reported number came from, so results cannot be regenerated without it.
# (There is no manifest.csv; only manifest_full.csv was ever produced.)
!artifacts/zuna_thesis/manifest_full.csv

# Reported results, as JSON rather than as prose in a document.
!artifacts/zuna_thesis/baseline_eval/*.json
!artifacts/zuna_thesis/baseline_eval/*.svg
!artifacts/zuna_thesis/compare_first10/*.json

# The cross-platform reference probabilities: 92 KB of float32, not a data set.
# It is the only way another machine can measure its drift against this one
# without shipping the corpus, and the figures in docs/portability.md are
# regenerated from it. See experiments/platform_drift.py.
!artifacts/drift_ref_windows.npz
!artifacts/drift_*.json

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db


# Reviewer autosave (crash-recovery record, not an export)
*.review.autosave.json

# thesis figures are generated, not hand-edited
!docs/figures/*.png
!docs/figures/*.pdf

# USB staging area: a 1.2 GB copy of the frozen application, assembled by
# packaging/make_usb.py. Regenerable from dist/, and far too large for git.
USB_STAGING/
build_log.txt
build_modern.log
regen_shard_*.log
